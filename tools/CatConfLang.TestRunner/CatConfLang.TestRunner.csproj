<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CatConfLang.TestRunner</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>CatConfLang.TestRunner</PackageId>
    <Description>Pluggable test runner for .NET CCL (CatConfLang) implementations. Loads the shared ccl-test-data corpus, classifies tests against the implementation's config, executes them, and emits human-readable + machine-readable (test-results-format v1.1.0) output.</Description>
    <PackageTags>ccl;catconflang;test-runner;testing</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CatConfLang.TestRunner.Abstractions\CatConfLang.TestRunner.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DiffPlex" Version="1.9.0" />
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

</Project>
