<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>CatConfLang.CclDotnet.Pacman</PackageId>
    <Description>F# Pacman parser core for CatConfLang CCL.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tools\CatConfLang.TestRunner.Abstractions\CatConfLang.TestRunner.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="ccl-pacman-config.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Library.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FParsec" Version="1.1.1" />
  </ItemGroup>

</Project>
